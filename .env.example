# Copy these into your hosting provider's "Environment variables" settings.

# Port (most hosts set this automatically)
PORT=3000

# First-time admin password (used only when data/users.json does not exist yet)
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional: email every booking enquiry ---
# Use a Gmail account + a Gmail "App Password" (Google Account > Security > App passwords)
SMTP_USER=Nirmaleconventiondemo@gmail.com
SMTP_PASS=
# Where enquiry emails are sent (defaults to the email in Business Info)
ENQUIRY_TO=Nirmaleconventiondemo@gmail.com

# --- Optional: keep data & uploads on a persistent disk ---
# DATA_DIR=/var/data/nirmale/data
# UPLOAD_DIR=/var/data/nirmale/uploads
